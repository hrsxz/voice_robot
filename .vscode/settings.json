{
    // Linter: ruff (配置在 pyproject.toml 的 [tool.ruff]); 本项目不再使用 pylint / flake8
    "pylint.enabled": false,
    "flake8.enabled": false,
    "ruff.enable": true,
    // 项目里的 ruff 配置优先于编辑器里的 ruff 设置
    "ruff.configurationPreference": "filesystemFirst",
    "editor.rulers": [
        88,
        100
    ],
    "editor.acceptSuggestionOnEnter": "off",
    "python.defaultInterpreterPath": ".venv/Scripts/python.exe",
    // Activate venv when start terminal
    "terminal.integrated.env.windows": {
        "PYTHONPATH": "${workspaceFolder};"
    },
    "terminal.integrated.defaultProfile.windows": "Command Prompt",
    "terminal.integrated.profiles.windows": {
        "Command Prompt": {
            "path": "cmd.exe",
            "args": [
                "/k",
                ".venv\\Scripts\\activate"
            ]
        }
    },
    // Set base path for python in linux
    "terminal.integrated.env.linux": {
        "PYTHONPATH": "${workspaceFolder}"
    },
    // Jupyter Notebook
    "jupyter.notebookFileRoot": "${workspaceFolder};",
    "notebook.output.textLineLimit": 15,
    "jupyter.outputSizeLimit": 10,
    "notebook.output.scrolling": false,
    // Activate formatting on save
    "python.formatting.provider": "black",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        // 保存时用 ruff 整理 import (和 ruff 的 I 规则一致)
        "source.organizeImports.ruff": "explicit"
    },
}